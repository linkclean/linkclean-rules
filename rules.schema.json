{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://linkclean.app/rules.schema.json",
  "title": "Link Clean Rules Schema v2.0",
  "description": "Schema for Link Clean's rules.json tracking-parameter removal ruleset",
  "type": "object",
  "required": ["version", "global_rules", "domain_rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version string. Must be incremented on every PR."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last update"
    },
    "global_rules": {
      "type": "array",
      "description": "Rules applied to every URL regardless of domain",
      "items": { "$ref": "#/definitions/Rule" }
    },
    "domain_rules": {
      "type": "array",
      "description": "Domain-specific rule groups",
      "items": { "$ref": "#/definitions/DomainRule" }
    }
  },
  "definitions": {
    "Rule": {
      "type": "object",
      "required": ["regex"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable identifier for the rule"
        },
        "regex": {
          "type": "string",
          "description": "JavaScript-compatible regex pattern applied to the URL query string"
        },
        "comment": {
          "type": "string",
          "description": "Optional explanation for contributors"
        }
      }
    },
    "DomainRule": {
      "type": "object",
      "required": ["domain_pattern", "rules"],
      "additionalProperties": false,
      "properties": {
        "domain_pattern": {
          "type": "string",
          "description": "Regex pattern matched against the URL hostname. Supports subdomains and TLD variants."
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Rule" }
        }
      }
    }
  }
}
